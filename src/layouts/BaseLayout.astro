---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileActions from "../components/MobileActions.astro";
import { site } from "../config/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  overlayHeader?: boolean;
}
const {
  title,
  description = site.description,
  canonical = Astro.url.pathname,
  image = "/images/og-default.jpg",
  overlayHeader = false,
} = Astro.props;
const canonicalUrl = new URL(canonical, site.url);
const imageUrl = new URL(image, site.url);
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.legalName,
  url: site.url,
  email: site.email,
  telephone: site.officeDisplay,
  contactPoint: [{
    "@type": "ContactPoint",
    telephone: site.hotlineDisplay,
    contactType: "sales",
    availableLanguage: ["th", "en"],
  }, {
    "@type": "ContactPoint",
    telephone: site.hotlineSecondaryDisplay,
    contactType: "sales",
    availableLanguage: ["th", "en"],
  }],
};
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <!--
      THESIS: SBCC turns one site photo into a practical next step; reject the generic card-first contractor homepage.
      OWN-WORLD: deep navy jobsite photography, oversized white Thai type, clean white fields, pale industrial blue, and one decisive orange action.
      STORY: visitors recognize the work, send a photo through LINE, then understand products, services, process, and evidence.
      FIRST VIEWPORT: full-bleed crane image, compact overlay navigation, dominant Thai headline at left, and the LINE action directly beneath it.
      FORM: photo-led construction standard, user-approved comp .impeccable/mocks/sbcc-home-approved.png, seed 7ab34994.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <Header overlay={overlayHeader} />
    <main class="overflow">
      <slot />
    </main>
    <Footer />
    <MobileActions />
  </body>
</html>
<style>.overflow { overflow-x: hidden; width: 100%; max-width: 100%; }</style>
