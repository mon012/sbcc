---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CatalogDetail from "../../../components/CatalogDetail.astro";
import { services } from "../../../data/catalog";
import { site } from "../../../config/site";
import SiteImage from "../../../components/SiteImage.astro";
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
---
<BaseLayout title={`${service.pageTitle} | SBCC Engineering`} description={`${service.sourceIntro} ติดต่อประเมินงานกับทีม SBCC`}>
  <section class="section">
    <div class="shell detail">
      <div>
        <p class="eyebrow">FIELD SERVICE</p>
        <h1 class="display">{service.pageTitle}</h1>
        <p class="lead">{service.sourceIntro}</p>
        <div class="cluster"><a class="button" href="/quote/">ขอประเมินราคา</a><a class="button secondary" href={site.hotlineHref}>โทร {site.hotlineDisplay}</a></div>
      </div>
      {service.image
        ? <SiteImage src={service.image} alt={"imageAlt" in service ? service.imageAlt : service.title} loading="eager" fetchpriority="high" />
        : <div class="detail-placeholder" aria-label="กำลังเตรียมข้อมูลบริการ"><span>กำลังเตรียมข้อมูลบริการ</span></div>}
    </div>
  </section>
  {service.detail && <CatalogDetail detail={service.detail} eyebrow="SERVICE DETAILS" />}
  <section class="section dark">
    <div class="shell service-process">
      <h2 class="section-title">ข้อมูลที่ช่วยให้ประเมินได้เร็วขึ้น</h2>
      <ol><li><b>พื้นที่หน้างาน</b><span>จังหวัด ประเภทอาคาร และข้อจำกัดการเข้าพื้นที่</span></li><li><b>ลักษณะโครงสร้าง</b><span>พื้น ผนัง ความหนา วัสดุฐาน และตำแหน่งที่ต้องทำงาน</span></li><li><b>ขอบเขตงาน</b><span>ขนาด จำนวนจุด พร้อมรูปหรือแบบที่เกี่ยวข้อง</span></li></ol>
    </div>
  </section>
</BaseLayout>
<style>
  .detail{display:grid;gap:4rem;align-items:center}.detail .lead{margin:1.5rem 0 2rem}.detail :global(img),.detail-placeholder{width:100%;aspect-ratio:6/5}.detail :global(img){height:auto;object-fit:cover}.detail-placeholder{display:grid;place-items:center;background:var(--blue-pale);color:var(--navy);font-family:"Noto Sans Thai",Arial,sans-serif;font-weight:700}.service-process{display:grid;gap:4rem}ol{margin:0;padding:0;list-style:none}li{display:grid;gap:.5rem;border-top:1px solid rgba(255,255,255,.24);padding:1.2rem 0}li b{font-family:"Noto Sans Thai",Arial,sans-serif;font-size:1.2rem}li span{color:#c7dbe2}
  @media(min-width:800px){.detail{grid-template-columns:1fr 1fr}.service-process{grid-template-columns:1fr 1fr}}
</style>
