---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { services } from "../../data/catalog";
import { site } from "../../config/site";
import SiteImage from "../../components/SiteImage.astro";

const serviceListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "บริการของ SBCC Engineering",
  numberOfItems: services.length,
  itemListElement: services.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.pageTitle,
    url: new URL(`/services/${item.slug}/`, site.url),
  })),
};
const breadcrumbs = [{ name: "หน้าแรก", url: "/" }, { name: "บริการ", url: "/services/" }];
---
<BaseLayout
  title="รับเจาะคอริ่ง ตัดคอนกรีต เจาะเสียบเหล็ก กรุงเทพ-ปริมณฑล | SBCC Engineering"
  description="รับเจาะคอริ่ง ตัดคอนกรีต เจาะเสียบเหล็ก ติดตั้งพุกเคมี สแกนหาเหล็ก และซ่อมพื้นด้วยโฟมและ Epoxy ส่งรูปให้ทีมช่วยประเมินหน้างาน"
  preloadImage="/images/services-hero-construction.webp"
  preloadImageMobile="/images/services-hero-construction-640.webp"
  ogImage="/images/services-hero-construction.webp"
  breadcrumbs={breadcrumbs}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceListSchema)} />
  <section class="section dark service-hero">
    <div class="shell">
      <Breadcrumb items={breadcrumbs} dark />
      <h1 class="display">ประเมินให้ชัด<br />ก่อนทีมงานลงมือ</h1>
      <p class="lead">ทีมงานตรวจพื้นที่ วางแผน และเตรียมอุปกรณ์ก่อนเริ่มงานตามขอบเขตที่ตกลงกัน</p>
    </div>
  </section>
  <section class="section">
    <div class="shell grid two listing">
      {services.map((item, index) => (
        <a class="card" href={`/services/${item.slug}/`}>
          {item.image
            ? <SiteImage
                src={item.image}
                alt={item.imageAlt}
                loading={index < 2 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
                widths={[480, 760, 1100]}
                sizes="(min-width: 640px) 50vw, 100vw"
              />
            : <div class="service-placeholder" aria-label="กำลังเตรียมข้อมูลบริการ"><span>กำลังเตรียมข้อมูลบริการ</span></div>}
          <div class="card-body"><h2>{item.title}</h2><p>{item.summary}</p></div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
<style>
  .service-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: min(760px, calc(100svh - 72px));
    align-items: center;
    overflow: hidden;
    background: var(--navy-deep);
  }
  .service-hero::before,
  .service-hero::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
  }
  .service-hero::before {
    background-image: url("/images/services-hero-construction.webp");
    background-position: 58% 52%;
    background-size: cover;
    filter: saturate(.72) contrast(1.08);
    transform: scale(1.015);
  }
  .service-hero::after {
    background:
      linear-gradient(90deg, rgba(3, 26, 49, .96) 0%, rgba(3, 40, 70, .82) 38%, rgba(3, 40, 70, .26) 74%, rgba(3, 40, 70, .14) 100%),
      linear-gradient(180deg, rgba(3, 24, 44, .18) 0%, rgba(3, 24, 44, .08) 48%, rgba(3, 24, 44, .78) 100%);
  }
  .service-hero::before,
  .service-hero::after {
    z-index: 0;
  }
  .service-hero .shell {
    position: relative;
    z-index: 1;
  }
  .service-hero .display { max-width: 780px; text-wrap: balance; text-shadow: 0 3px 24px rgba(0, 0, 0, .28); }
  .service-hero .lead { max-width: 620px; margin-top: 1.5rem; color: rgba(255, 255, 255, .78); }
  .listing .card { min-height: 480px; }
  .listing :global(img),
  .service-placeholder { height: 330px; }
  .service-placeholder {
    display: grid;
    place-items: center;
    background: var(--blue-pale);
    color: var(--navy);
    font-family: "Noto Sans Thai", Arial, sans-serif;
    font-weight: 700;
  }
  .listing h2 { font-size: 1.8rem; }
  @media (max-width: 860px) {
    .service-hero::before { background-image: url("/images/services-hero-construction-640.webp"); }
  }
  @media (max-width: 700px) {
    .service-hero { min-height: 640px; }
    .service-hero::before { background-position: 63% center; }
    .service-hero::after {
      background:
        linear-gradient(90deg, rgba(3, 26, 49, .94), rgba(3, 40, 70, .44)),
        linear-gradient(180deg, rgba(3, 24, 44, .16), rgba(3, 24, 44, .86));
    }
  }
</style>
