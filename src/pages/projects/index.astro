---
import BaseLayout from "../../layouts/BaseLayout.astro";
import legacyPages from "../../data/legacy-pages.json";
const projects = legacyPages.filter((page) => page.type === "project");
---
<BaseLayout title="ผลงานบริการวิศวกรรม | SBCC Engineering" description="ตัวอย่างผลงานเจาะคอริ่ง ติดตั้งพุกเคมี และงานวิศวกรรมของทีม SBCC">
  <section class="section dark"><div class="shell"><p class="eyebrow">FIELD RECORD</p><h1 class="display">ประสบการณ์จาก<br />หน้างานหลากหลายประเภท</h1><p class="lead">โครงการภาคอุตสาหกรรม อาคาร สถาบันการศึกษา และโครงสร้างพื้นฐาน</p></div></section>
  <section class="section"><div class="shell project-grid">{projects.map((project, index) => <a href={project.path}><span>{String(index + 1).padStart(2,"0")}</span>{project.images[0] && <img src={project.images[0].src} alt={project.images[0].alt || project.heading} loading="lazy" />}<h2>{project.heading}</h2><p>{project.description || project.blocks.find((block)=>block.tag==="p")?.text || "ดูรายละเอียดจากคลังผลงานเดิมของ SBCC"}</p><b>ดูผลงาน →</b></a>)}</div></section>
</BaseLayout>
<style>
  .lead{margin-top:1.5rem}.project-grid{display:grid;grid-auto-flow:dense;gap:1px;border:1px solid #d9d9d0;border-radius:1.25rem;overflow:hidden;background:#d9d9d0}.project-grid a{min-height:360px;padding:1rem;background:#fffdf8;text-decoration:none}.project-grid span{color:#9e2f18;font-weight:700}.project-grid img{width:100%;height:220px;margin:.8rem 0 1.5rem;object-fit:cover;transition:transform .7s ease}.project-grid a:hover img{transform:scale(1.035)}.project-grid h2{margin:1rem 0;font-size:1.45rem}.project-grid p{color:#626963}.project-grid b{display:inline-block;margin-top:1.5rem;font-family:"Noto Sans Thai",Arial,sans-serif}@media(min-width:640px){.project-grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:1024px){.project-grid{grid-template-columns:repeat(3,1fr)}}
</style>
