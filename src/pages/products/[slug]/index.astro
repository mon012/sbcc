---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import CatalogDetail from "../../../components/CatalogDetail.astro";
import { products, services } from "../../../data/catalog";
import { site } from "../../../config/site";
import SiteImage from "../../../components/SiteImage.astro";
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const relatedService = "relatedServiceSlug" in product
  ? services.find((service) => service.slug === product.relatedServiceSlug)
  : undefined;
const breadcrumbs = [{ name: "หน้าแรก", url: "/" }, { name: "สินค้า", url: "/products/" }, { name: product.title, url: `/products/${product.slug}/` }];
---
<BaseLayout
  title={`${product.pageTitle} | SBCC Engineering`}
  description={`${product.sourceIntro} สอบถามราคาและสเปกกับทีม SBCC`}
  breadcrumbs={breadcrumbs}
>
  <section class="section">
    <div class="shell detail">
      <div>
        <Breadcrumb items={breadcrumbs} />
        <p class="eyebrow">ENGINEERING SUPPLY</p>
        <h1 class="display">{product.pageTitle}</h1>
        <p class="lead">{product.sourceIntro}</p>
        <div class="cluster"><a class="button" href="/quote/">ขอใบเสนอราคา</a><a class="button secondary" href={site.lineHref} target="_blank" rel="noopener noreferrer">สอบถามทาง LINE</a></div>
      </div>
      {product.image
        ? <SiteImage src={product.image} alt={product.imageAlt} loading="eager" fetchpriority="high" />
        : <div class="detail-placeholder" aria-label="กำลังเตรียมข้อมูลสินค้า"><span>กำลังเตรียมข้อมูลสินค้า</span></div>}
    </div>
  </section>
  {product.detail && (
    <CatalogDetail
      detail={product.detail}
      eyebrow="PRODUCT DETAILS"
      relatedLink={relatedService && { label: relatedService.pageTitle, href: `/services/${relatedService.slug}/` }}
    />
  )}
  {"video" in product && product.video && (
    <section class="section product-video">
      <div class="shell video-layout">
        <h2 class="section-title">วิดีโอแนะนำพุกเคมี HILTI</h2>
        <div class="video-frame">
          <iframe
            src={product.video.embedUrl}
            title={product.video.title}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>
  )}
  <section class="section dark">
    <div class="shell buying-grid">
      <h2 class="section-title">ข้อมูลที่ช่วยให้เสนอราคาได้แม่นขึ้น</h2>
      <div class="buying-details">
        <details open><summary>รุ่นและขนาด</summary><p>แจ้งชื่อรุ่น เส้นผ่านศูนย์กลาง ความยาว หรือมาตรฐานที่ระบุในแบบ</p></details>
        <details><summary>จำนวนและพื้นที่จัดส่ง</summary><p>แจ้งจำนวนที่ต้องการและจังหวัดปลายทาง เพื่อประเมินสต็อกและการจัดส่ง</p></details>
        <details><summary>กรณียังไม่ทราบรุ่น</summary><p>ส่งรูป แบบ หรือลักษณะการใช้งานให้ทีมงานช่วยตรวจสอบเบื้องต้น</p></details>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .detail{display:grid;gap:4rem;align-items:center}.detail .lead{margin:1.5rem 0 2rem}.detail :global(img),.detail-placeholder{width:100%;height:auto;aspect-ratio:6/5}.detail :global(img){object-fit:cover}.detail-placeholder{display:grid;place-items:center;background:var(--blue-pale);color:var(--navy);font-family:"Noto Sans Thai",Arial,sans-serif;font-weight:700}
  .video-layout{display:grid;gap:clamp(2.5rem,6vw,5rem)}.video-frame{position:relative;overflow:hidden;aspect-ratio:16/9;background:var(--navy-deep)}.video-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .buying-grid{display:grid;gap:4rem}.buying-details{border-top:1px solid rgba(255,255,255,.24)}details{border-bottom:1px solid rgba(255,255,255,.24);padding:1.2rem 0}summary{cursor:pointer;font-family:"Noto Sans Thai",Arial,sans-serif;font-size:1.25rem;font-weight:700}details p{padding-top:1rem;color:#c7dbe2}
  @media(min-width:800px){.detail{grid-template-columns:1fr 1fr}.video-layout{grid-template-columns:minmax(260px,.65fr) minmax(0,1.35fr);align-items:start}.buying-grid{grid-template-columns:1fr 1fr}}
</style>
