---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products } from "../../data/catalog";
import chemicalAnchorsImage from "../../assets/images/product-listing/chemical-anchors.webp";
import epoxyAdhesiveImage from "../../assets/images/product-listing/epoxy-adhesive.webp";
import hiltiChemicalAnchorsImage from "../../assets/images/product-listing/hilti-chemical-anchors.webp";
import castInAnchorsImage from "../../assets/images/product-listing/cast-in-anchors.webp";

const productImages = {
  "chemical-anchors": chemicalAnchorsImage,
  "epoxy-adhesive": epoxyAdhesiveImage,
  "hilti-chemical-anchors": hiltiChemicalAnchorsImage,
  "cast-in-anchors": castInAnchorsImage,
} as const;
---
<BaseLayout title="พุกเคมี น้ำยาเจาะเสียบเหล็ก และพุกฝังคอนกรีต | SBCC" description="พุกเคมี น้ำยาเจาะเสียบเหล็ก และพุกฝังคอนกรีต ส่งรายการให้ทีม SBCC ช่วยตรวจสเปกและเสนอราคา">
  <section class="section">
    <div class="shell">
      <p class="eyebrow">ENGINEERING SUPPLY</p>
      <h1 class="display">ส่งรายการมา<br />ให้ช่วยตรวจสเปก</h1>
      <p class="lead">แจ้งรุ่น ขนาด ปริมาณ และลักษณะการใช้งาน หากยังไม่ทราบรุ่น ส่งแบบหรือรูปหน้างานให้ทีมงานช่วยตรวจได้</p>
    </div>
  </section>
  <section class="shell grid two listing">
    {products.map((item, index) => (
      <a class="card" href={`/products/${item.slug}/`}>
        {item.image
          ? <Image
              src={productImages[item.slug]}
              alt={item.imageAlt}
              loading={index < 2 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
            />
          : <div class="product-placeholder" aria-label="กำลังเตรียมข้อมูลสินค้า"><span>กำลังเตรียมข้อมูลสินค้า</span></div>}
        <div class="card-body"><h2>{item.title}</h2><p>{item.summary}</p></div>
      </a>
    ))}
  </section>
  <div class="section"></div>
</BaseLayout>
<style>.section .display{font-size:clamp(3rem,5.263vw,4.46375rem)}.section .lead{margin-top:1.5rem}.listing .card{min-height:480px}.listing :global(img),.product-placeholder{height:330px}.product-placeholder{display:grid;place-items:center;background:var(--blue-pale);color:var(--navy);font-family:"Noto Sans Thai",Arial,sans-serif;font-weight:700}.listing h2{font-size:1.8rem}</style>
