---
import BaseLayout from "../layouts/BaseLayout.astro";
import legacyPages from "../data/legacy-pages.json";
import legacyEmbeds from "../data/legacy-embeds.json";
import { site } from "../config/site";

export function getStaticPaths() {
  return legacyPages.map((page) => ({
    params: { path: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
type LegacyEmbed = {
  type: "document" | "video";
  title: string;
  src: string;
};
const embedsByPath = legacyEmbeds as Record<string, LegacyEmbed[]>;
const pageEmbeds: LegacyEmbed[] = embedsByPath[page.path] || [];
const isHiltiHvu = page.path === "/products/chemical-anchors/hilti-hvu/";
const isAnchorSizeArticle = page.path === "/ตารางพุกเคมี/";
const isAnchorUsageArticle = page.path === "/การใช้งานพุกเคมี/";
const isLeadAnchorArticle = page.path === "/พุกตะกั่ว/";
const visibleDescription =
  page.type === "article"
    ? page.description.replace(/^by mon012 \|\s*/, "")
    : page.description;
const asideTitle =
  isHiltiHvu ? "พุกเคมี Hilti HVU แบบปั่น"
  : page.path === "/products/chemical-anchors/stud-hot-dip-galvanized/" ? "Stud Hot-Dip Galvanized"
  : page.type === "project" ? "รายละเอียดผลงาน"
  : page.heading;
const contentBlocks = page.blocks.filter((block) => {
  if (["ขอใบเสนอราคา", "ติดต่อฝ่ายขาย", "พูดคุยผ่าน Line", "ผลงานของเรา"].includes(block.text)) return false;
  if (page.type === "article" && /^by mon012 \|/.test(block.text)) return false;
  if (isAnchorSizeArticle && ["th", "td"].includes(block.tag)) return false;
  if (
    isAnchorSizeArticle &&
    (block.text === "วิธีการใช้งานพุกเคมีพร้อมสตัด" || block.text.startsWith("แต่ละยี่ห้อจะมีความแตกต่าง"))
  ) return false;
  if (
    isAnchorUsageArticle &&
    (block.text === "วิธีใช้ และการติดตั้ง พุกเคมีแบบตอก" || block.text === "อ้างอิง แหล่งที่มา")
  ) return false;
  if (
    isLeadAnchorArticle &&
    block.tag === "p" &&
    (block.text.startsWith("ผมต้องการยึดแป้นที่มีห่วง") || block.text.startsWith("รบกวนสอบถามว่า"))
  ) return false;
  return true;
});
const anchorSizeSpecifications = [
  ["M10", "10", "130", "12", "20", "90"],
  ["M12", "12", "160", "14", "25", "110"],
  ["M16", "16", "190", "18", "35", "125"],
  ["M20", "20", "260", "22", "65", "170"],
  ["M24", "24", "300", "26", "63", "210"],
  ["M30", "30", "380", "35", "70", "280"],
];
const coverImage =
  page.path === "/products/chemical-anchors/hammer-capsule-anchor/"
    ? page.images.find((image) => image.src === "/legacy-assets/3b226fe6e4-Hammer-Type-Glass-Capsule-Anchor.jpg")
    : page.path === "/products/epoxy-adhesive/epoxy-dispensers/"
      ? page.images.find((image) => image.src === "/legacy-assets/4e6a20191c-epoxy-gun-1.jpg")
    : page.path === "/products/chemical-anchors/vdp-glass-capsules/"
      ? page.images.find((image) => image.src === "/legacy-assets/f93015e5e6-VDP-Quartz-Glass-Capsules.jpg")
    : page.path === "/products/mechanical-bolt/expansion-bolt-st/"
      ? page.images.find((image) => image.src === "/legacy-assets/80989e0dce-anchor-Galvanized.jpg")
    : page.path === "/products/mechanical-bolt/expansion-bolt-ss304/"
      ? page.images.find((image) => image.src === "/legacy-assets/5c22e6922f-expansion-bolt-ss304.jpg")
    : page.path === "/products/mechanical-bolt/expansion-bolt-hot-dip-galvanized/"
      ? page.images.find((image) => image.src === "/legacy-assets/5d72b722bf-expanion-bolt-hot-dip.jpg")
    : page.path === "/products/mechanical-bolt/expansion-bolt-2/"
      ? page.images.find((image) => image.src === "/legacy-assets/35d506b3b6-expansion-bolt.jpg")
    : page.type === "product" && page.images[1]
      ? page.images[1]
      : page.images[0];
const inlineContentImage =
  page.path === "/products/chemical-anchors/hammer-capsule-anchor/"
    ? page.images.find((image) => image.src === "/legacy-assets/81c8014c63-hammer-anchor.jpg")
    : undefined;
const introInlineImage =
  page.path === "/products/chemical-anchors/hammer-capsule-anchor/"
    ? page.images.find((image) => image.src === "/legacy-assets/adbcb5f1ef-install-hammer-anchor.gif")
    : undefined;
const vdpInlineImage =
  page.path === "/products/chemical-anchors/vdp-glass-capsules/"
    ? page.images.find((image) => image.src === "/legacy-assets/1977639365-พ-กเคม-แบบป--น.jpg")
    : undefined;
const expansionBoltInlineImage =
  [
    "/products/mechanical-bolt/expansion-bolt-st/",
    "/products/mechanical-bolt/expansion-bolt-ss304/",
  ].includes(page.path)
    ? page.images.find((image) => image.src === "/legacy-assets/fd4ac5a9af-Screen-Shot-2560-06-19-at-12.10.04.png")
    : undefined;
const hotDipInlineImage =
  page.path === "/products/mechanical-bolt/expansion-bolt-hot-dip-galvanized/"
    ? page.images.find((image) => image.src === "/legacy-assets/f65b306675-Screen-Shot-2560-06-19-at-12.10.25.png")
    : undefined;
const hotDipSpecifications = [
  ["M8", "35", "8", "50"],
  ["M10", "25", "10", "60"],
  ["M12", "8", "12", "70"],
  ["M12", "21", "12", "70"],
  ["M12", "61", "12", "70"],
  ["M12", "101", "12", "70"],
  ["M16", "3", "16", "90"],
  ["M16", "21", "16", "90"],
  ["M16", "46", "16", "90"],
  ["M16", "71", "16", "90"],
  ["M20", "7", "20", "105"],
  ["M20", "37", "20", "105"],
  ["M20", "92", "20", "105"],
];
const galleryImages = page.images.filter((image) =>
  image.src !== coverImage?.src &&
  image.src !== inlineContentImage?.src &&
  image.src !== introInlineImage?.src &&
  image.src !== vdpInlineImage?.src &&
  image.src !== expansionBoltInlineImage?.src &&
  image.src !== hotDipInlineImage?.src
);
const hideLegacyGallery =
  isHiltiHvu ||
  [
    "/products/mechanical-bolt/expansion-bolt-hot-dip-galvanized/",
    "/products/mechanical-bolt/expansion-bolt-2/",
    "/products/epoxy-adhesive/epoxy-dispensers/",
    "/products/epoxy-adhesive/mason-mca-pe3/",
    "/services/hilti-services/install-hilti-hvu/",
    "/services/hilti-services/install-hilti-re500v3/",
  ].includes(page.path);
---
<BaseLayout title={`${page.title} | SBCC Engineering`} description={page.description || page.heading}>
  <article class={`legacy-page legacy-${page.type}`}>
    <header class="legacy-hero section">
      <div class="shell legacy-hero-grid">
        <div>
          <p class="eyebrow">{page.type === "project" ? "PROJECT RECORD" : page.type === "product" ? "PRODUCT DETAILS" : page.type === "service" ? "SERVICE DETAILS" : "ENGINEERING NOTES"}</p>
          <h1 class="display">{page.heading}</h1>
          {visibleDescription && <p class="lead">{visibleDescription}</p>}
          <div class="cluster">
            <a class="button" href="/quote/">ขอใบเสนอราคา</a>
            <a class="button secondary" href={site.lineHref} target="_blank" rel="noopener noreferrer">สอบถามทาง LINE</a>
          </div>
        </div>
        {coverImage && <img class="legacy-cover motion-image" src={coverImage.src} alt={coverImage.alt || `ภาพประกอบ ${page.heading}`} width="760" height="620" />}
      </div>
    </header>

    <section class="section legacy-content">
      <div class="shell content-grid">
        <aside>
          <h2>{asideTitle}</h2>
        </aside>
        <div class="prose">
          {contentBlocks.map((block) => (
            <>
              {block.tag === "h2" ? <h2>{block.text}</h2>
              : ["h3", "h4"].includes(block.tag) ? <h3>{block.text}</h3>
              : block.tag === "li" ? <p class="list-item">{block.text}</p>
              : block.tag === "blockquote" ? <blockquote>{block.text}</blockquote>
              : ["th", "td"].includes(block.tag) ? <p class="spec-line">{block.text}</p>
              : <p>{block.text}</p>}
              {introInlineImage && block.text.startsWith("พุกเคมี แบบตอก") && (
                <img class="inline-content-image" src={introInlineImage.src} alt={introInlineImage.alt || "ขั้นตอนติดตั้ง Hammer-Type Glass Capsule Anchor"} loading="lazy" />
              )}
              {vdpInlineImage && block.text.startsWith("พุกเคมี แบบปั่น") && (
                <img class="inline-content-image" src={vdpInlineImage.src} alt={vdpInlineImage.alt || "ขั้นตอนติดตั้งพุกเคมีแบบปั่น"} loading="lazy" />
              )}
              {inlineContentImage && block.text.startsWith("การติดตั้งช่างจะทำการเจาะรูบนคอนกรีต") && (
                <img class="inline-content-image" src={inlineContentImage.src} alt={inlineContentImage.alt || "การติดตั้ง Hammer-Type Glass Capsule Anchor"} loading="lazy" />
              )}
            </>
          ))}
          {isAnchorSizeArticle && (
            <>
              <h2>ตารางขนาดพุกเคมี</h2>
              <div class="spec-table-wrap">
                <table class="spec-table" aria-label="ตารางขนาดพุกเคมี">
                  <thead>
                    <tr>
                      <th scope="col">แท่งเกลียว</th>
                      <th scope="col">ขนาดพุก<br />(มม.)</th>
                      <th scope="col">ความยาวสตัด<br />(มม.)</th>
                      <th scope="col">เส้นผ่านศูนย์กลางรู<br />(มม.)</th>
                      <th scope="col">ระยะติดตั้งสูงสุด<br />(มม.)</th>
                      <th scope="col">ความลึกรูต่ำสุด<br />(มม.)</th>
                    </tr>
                  </thead>
                  <tbody>
                    {anchorSizeSpecifications.map((row) => (
                      <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="article-note">แต่ละยี่ห้ออาจมีขนาดแตกต่างกันเล็กน้อย ตารางนี้เป็นข้อมูลของพุกเคมีที่ SBCC จำหน่าย</p>
            </>
          )}
          {expansionBoltInlineImage && (
            <img
              class="inline-content-image"
              src={expansionBoltInlineImage.src}
              alt={expansionBoltInlineImage.alt || `วิธีติดตั้ง ${page.heading}`}
              loading="lazy"
            />
          )}
          {hotDipInlineImage && (
            <div class="spec-table-wrap">
              <table class="spec-table" aria-label="ตารางขนาด Expansion Bolt Hot-Dip Galvanized">
                <thead>
                  <tr>
                    <th scope="col">ขนาดแท่งเกลียว<br />(Thread Ø)</th>
                    <th scope="col">ความหนาสูงสุดของชิ้นงาน (มม.)<br />(Max Fixture Thickness)</th>
                    <th scope="col">เส้นผ่านศูนย์กลางรูเจาะ (มม.)<br />(Hole Ø)</th>
                    <th scope="col">ความลึกต่ำสุดของรูเจาะ (มม.)<br />(Min Hole Depth)</th>
                  </tr>
                </thead>
                <tbody>
                  {hotDipSpecifications.map((row) => (
                    <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </div>
    </section>

    {pageEmbeds.length > 0 && (
      <section class="section embed-section">
        <div class="shell">
          <p class="eyebrow">TECHNICAL DOCUMENTS &amp; VIDEOS</p>
          <h2 class:list={["section-title", { "anchor-usage-embed-title": isAnchorUsageArticle }]}>
            {isAnchorSizeArticle
              ? "วิธีการใช้งานพุกเคมีพร้อมสตัด"
              : isAnchorUsageArticle
                ? "วิธีใช้และการติดตั้งพุกเคมีแบบตอก"
              : page.type === "article"
                ? "ข้อมูลประกอบบทความ"
                : "ข้อมูลประกอบผลิตภัณฑ์"}
          </h2>
          <div class="embed-grid">
            {pageEmbeds.map((embed) => (
              <article class={`embed-card embed-${embed.type}`}>
                <h3>{embed.title}</h3>
                <div class="embed-frame">
                  <iframe
                    src={embed.src}
                    title={embed.title}
                    loading="lazy"
                    allow={embed.type === "video" ? "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" : "fullscreen"}
                    allowfullscreen
                    referrerpolicy="strict-origin-when-cross-origin"
                  ></iframe>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {!hideLegacyGallery && galleryImages.length > 0 && (
      <section class="legacy-gallery section dark">
        <div class="shell">
          <h2 class="section-title">ภาพจากงานและข้อมูลเดิม</h2>
          <div class="gallery-grid">
            {galleryImages.map((image, index) => <img class="motion-image" src={image.src} alt={image.alt || `ภาพประกอบ ${page.heading} ลำดับที่ ${index + 1}`} loading="lazy" />)}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
<style>
  .legacy-hero-grid{display:grid;gap:4rem;align-items:center}.legacy-hero .lead{margin:1.5rem 0 2rem}.legacy-cover{width:100%;aspect-ratio:6/5;object-fit:cover;border-radius:var(--radius)}
  .content-grid{display:grid;gap:4rem}.content-grid aside h2{font-size:1.5rem}.prose{max-width:760px}.prose h2{margin:3.5rem 0 1.2rem;font-size:clamp(1.8rem,3vw,2.7rem)}.prose h3{margin:2.5rem 0 1rem;font-size:1.4rem}.prose p{margin-bottom:1.25rem;color:#444c47}.prose .list-item{position:relative;padding-left:1.4rem}.prose .list-item::before{position:absolute;left:0;color:var(--brand);content:"—"}.prose blockquote{margin:2rem 0;border-left:4px solid var(--brand);padding:1rem 0 1rem 1.5rem;font-size:1.2rem}.spec-line{border-bottom:1px solid var(--line);padding:.7rem 0}.inline-content-image{display:block;width:100%;margin:1rem 0 2.5rem;border-radius:var(--radius)}
  .spec-table-wrap{margin:1rem 0 2.5rem;overflow-x:auto;border:1px solid var(--line);border-radius:var(--radius);background:#fff}.spec-table{width:100%;min-width:680px;border-collapse:collapse;text-align:center}.spec-table th,.spec-table td{border-top:1px solid var(--line);border-right:1px solid var(--line);padding:.8rem .65rem}.spec-table th:last-child,.spec-table td:last-child{border-right:0}.spec-table th{background:#f0eee8;color:#202522;font-size:.9rem;line-height:1.45}.spec-table tbody tr:nth-child(even){background:#faf9f5}
  .embed-section{border-top:1px solid var(--line);background:#e9e6de}.embed-section .section-title{max-width:760px;margin:.5rem 0 2.5rem}.embed-grid{display:grid;gap:1.5rem}.embed-card{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:#fff}.embed-card h3{margin:0;padding:1.2rem 1.4rem;border-bottom:1px solid var(--line);font-size:1.15rem}.embed-frame{position:relative;width:100%;height:min(74vh,760px);background:#202522}.embed-video .embed-frame{height:auto;aspect-ratio:16/9}.embed-frame iframe{display:block;width:100%;height:100%;border:0}
  .embed-section .anchor-usage-embed-title{font-size:clamp(2.1rem,calc(4.2vw - 1px),4rem)}
  .legacy-gallery h2{margin-bottom:3rem}.gallery-grid{display:grid;grid-auto-flow:dense;grid-template-columns:repeat(12,1fr);gap:1px;background:#38413d}.gallery-grid img{grid-column:span 6;width:100%;height:360px;object-fit:cover}.gallery-grid img:nth-child(3n+1){grid-column:span 8}.gallery-grid img:nth-child(3n+2){grid-column:span 4}
  @media(min-width:850px){.legacy-hero-grid{grid-template-columns:1fr 1fr}.content-grid{grid-template-columns:280px 1fr}.content-grid aside{position:sticky;top:110px;align-self:start}}
  @media(max-width:700px){.gallery-grid{grid-template-columns:1fr}.gallery-grid img,.gallery-grid img:nth-child(n){grid-column:auto;height:260px}}
</style>
