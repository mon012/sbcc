---
import BaseLayout from "../layouts/BaseLayout.astro";
import LineAppIcon from "../components/LineAppIcon.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import SiteImage from "../components/SiteImage.astro";
import { products, services } from "../data/catalog";
import { site } from "../config/site";

const projectEvidence = [
  { src: "/legacy-assets/4bcbd9a842-17457931_1220685707987305_9128082814653951827_n.jpg", alt: "หน้างานก่อสร้างบ้านพัก" },
  { src: "/images/project-construction-site.webp", alt: "หน้างานก่อสร้างอาคาร" },
  { src: "/legacy-assets/f50c93838f-20770198_1343721455683729_5890634755612042816_n.jpg", alt: "ผลงานหน้างานคอนโดมิเนียม" },
  { src: "/legacy-assets/c49575136b-22687962_1398881913501016_5008216070809313268_n.jpg", alt: "งานเจาะคอริ่งแผ่นคอนกรีตสำเร็จรูป" },
];
---
<BaseLayout
  title="บริษัท เอสบีซีซี เอ็นจิเนียริ่ง แอนด์ ซัพพลาย จำกัด"
  description="ส่งรูปหน้างาน แบบ หรือรายการสินค้าให้ทีม SBCC ช่วยประเมิน จำหน่ายอุปกรณ์วิศวกรรมและให้บริการติดตั้ง พร้อมจัดส่งทั่วไทย"
  overlayHeader
>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-photo" aria-hidden="true"></div>
    <div class="shell hero-content">
      <h1 id="home-title">ส่งรูปหน้างาน<br />ให้เราช่วยประเมิน</h1>
      <p>SBCC เปิดให้บริการทุกวัน ตั้งแต่เวลา 8:30 – 17:30 น.</p>
      <div class="hero-actions">
        <a class="button hero-line" href={site.lineHref} target="_blank" rel="noopener noreferrer">
          <LineAppIcon />สอบถามเพิ่มเติมทาง LINE
        </a>
        <a class="text-link" href="/quote/">ขอใบเสนอราคา <span><ArrowIcon direction="up-right" /></span></a>
      </div>
    </div>
  </section>

  <section class="intake section">
    <div class="shell intake-layout">
      <h2 class="section-title">เริ่มจากข้อมูลที่คุณมี</h2>
      <div class="intake-copy">
        <p class="lead">ส่งรูปภาพ, Drawing, รายการสินค้า หรือแจ้งปัญหาเบื้องต้น ให้ทีมงานของเราช่วยประเมินปัญหาและสิ่งที่ต้องการ</p>
        <ol>
          <li><strong>ส่งข้อมูล</strong><span>รูปหน้างาน แบบ หรือรายการสินค้า</span></li>
          <li><strong>ทีมงานประเมิน</strong><span>สเปก ปริมาณ เงื่อนไขหน้างาน และระยะเวลา</span></li>
          <li><strong>รับคำแนะนำ</strong><span>แนวทางสินค้า บริการ และใบเสนอราคา</span></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="capabilities" id="capabilities">
    <div class="capability product-capability">
      <div class="capability-image">
        <SiteImage src="/images/product-chemical.jpg" alt="พุกเคมีและอุปกรณ์วิศวกรรม" />
      </div>
      <div class="capability-copy">
        <h2>สินค้าและอุปกรณ์<br />พร้อมคำแนะนำ</h2>
        <p>เช็ครุ่น ขนาด ปริมาณ และเงื่อนไขใช้งานก่อนเสนอราคา</p>
        <nav aria-label="หมวดสินค้า">
          {products.map((item) => (
            <a href={`/products/${item.slug}/`}><span>{item.title}</span><b><ArrowIcon direction="up-right" /></b></a>
          ))}
        </nav>
        <a class="button secondary" href="/products/">ดูสินค้าทั้งหมด</a>
      </div>
    </div>

    <div class="capability service-capability">
      <div class="capability-image">
        <SiteImage src="/images/services-hero-construction.webp" alt="ทีมบริการวิศวกรรมปฏิบัติงานในโครงการก่อสร้าง" />
      </div>
      <div class="capability-copy">
        <h2>ประเมินหน้างาน พร้อมแนวทางแก้ปัญหา</h2>
        <p>ตรวจพื้นที่ วางแผน เตรียมอุปกรณ์ และดำเนินงานตามขอบเขต</p>
        <nav aria-label="หมวดบริการ">
          {services.map((item) => (
            <a href={`/services/${item.slug}/`}><span>{item.title}</span><b><ArrowIcon direction="up-right" /></b></a>
          ))}
        </nav>
        <a class="button service-button" href="/services/">ดูบริการทั้งหมด</a>
      </div>
    </div>
  </section>

  <section class="evidence section">
    <div class="shell evidence-head">
      <h2 class="section-title">ดูผลงานจริง<br />ก่อนตัดสินใจ</h2>
      <p class="lead">ภาพจากคลังผลงานเดิมของ SBCC ครอบคลุมงานอาคาร โรงงาน สถาบันการศึกษา หน่วยงานรัฐ และโครงสร้างพื้นฐาน</p>
    </div>
    <div class="shell evidence-grid">
      {projectEvidence.map((project) => (
        <div class="evidence-item">
          <SiteImage src={project.src} alt={project.alt} />
        </div>
      ))}
    </div>
    <div class="shell evidence-action"><a class="button evidence-button" href="https://www.facebook.com/profile.php?id=100063526152006" target="_blank" rel="noopener noreferrer">ดูผลงานที่ผ่านมา <span><ArrowIcon direction="up-right" /></span></a></div>
  </section>

</BaseLayout>

<script>
  import gsap from "gsap";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.fromTo(".hero-content > *", { y: 42, opacity: 0 }, {
      y: 0,
      opacity: 1,
      duration: 1.05,
      stagger: .12,
      ease: "power4.out",
      delay: .12,
    });
    gsap.fromTo(".hero-photo", { scale: 1.07 }, { scale: 1, duration: 1.8, ease: "power3.out" });
  }
</script>

<style>
  .hero { position: relative; isolation: isolate; display: grid; min-height: min(860px,100svh); align-items: end; overflow: hidden; background: var(--navy-deep); color: white; }
  .hero-photo { position: absolute; inset: 0; z-index: -2; background: url("/images/hero-construction-crane.webp") center 53%/cover no-repeat; }
  .hero::before { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg,rgba(3,26,49,.93) 0%,rgba(3,38,70,.74) 42%,rgba(3,38,70,.16) 78%),linear-gradient(0deg,rgba(3,24,44,.74),transparent 52%); content:""; }
  .hero::after { position: absolute; right: 0; bottom: 0; left: 0; height: 1px; background: rgba(255,255,255,.35); content:""; }
  .hero-content { padding-top: 10rem; padding-bottom: clamp(5rem,9vh,7.5rem); }
  .hero h1 { max-width: 800px; font-size: clamp(3.4rem,7.25vw,5.5rem); font-weight: 700; letter-spacing: -.035em; }
  .hero p { max-width: 640px; margin-top: 1.6rem; color: #d7e7ec; font-size: clamp(1.06rem,1.6vw,1.3rem); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem; margin-top: 2.2rem; }
  .hero-line { min-width: 190px; }
  .text-link { display: inline-flex; align-items: center; gap: .65rem; color: var(--navy); font-family:"Noto Sans Thai",Arial,sans-serif; font-weight:700; text-decoration:none; }
  .hero .text-link { color:white; }
  .text-link span { display:grid; width:34px; height:34px; place-items:center; border:1px solid currentColor; border-radius:50%; transition:transform .3s var(--ease-out); }
  .text-link:hover span { transform:translate(2px,-2px); }

  .intake { background:white; }
  .intake-layout { display:grid; gap:3.5rem; }
  .intake-copy .lead { margin-bottom:3rem; }
  .intake ol { margin:0; padding:0; border-top:1px solid var(--line); list-style:none; counter-reset:steps; }
  .intake li { display:grid; grid-template-columns:minmax(150px,.8fr) 1.4fr; gap:2rem; border-bottom:1px solid var(--line); padding:1.25rem 0; counter-increment:steps; }
  .intake li strong { font-family:"Noto Sans Thai",Arial,sans-serif; }
  .intake li strong::before { margin-right:.8rem; color:var(--brand); content:"0" counter(steps); }
  .intake li span { color:var(--muted); }

  .capabilities { border-top:1px solid var(--line); }
  .capability { display:grid; min-height:720px; }
  .capability-image { min-height:420px; overflow:hidden; }
  .capability-image :global(img) { width:100%; height:100%; object-fit:cover; transition:transform 1s var(--ease-out); }
  .capability:hover .capability-image :global(img) { transform:scale(1.025); }
  .capability-copy { display:flex; flex-direction:column; justify-content:center; padding:clamp(3rem,6vw,6rem); }
  .capability h2 { font-size:clamp(2.5rem,4.6vw,5rem); }
  .service-capability h2 { font-size:clamp(2.4rem,4.3vw,4.75rem); }
  .capability-copy > p { max-width:520px; margin:1.35rem 0 2.5rem; color:var(--muted); }
  .capability nav { margin-bottom:2.5rem; border-top:1px solid var(--line); }
  .capability nav a { display:flex; align-items:center; justify-content:space-between; gap:1rem; border-bottom:1px solid var(--line); padding:1rem 0; font-family:"Noto Sans Thai",Arial,sans-serif; font-weight:700; text-decoration:none; }
  .capability nav b { font-size:1.1rem; transition:transform .3s var(--ease-out); }
  .capability nav a:hover b { transform:translate(3px,-3px); }
  .capability .button { align-self:flex-start; }
  .service-capability { background:var(--navy-deep); color:white; }
  .service-capability .capability-copy > p { color:#c7dbe2; }
  .service-capability nav { border-color:rgba(255,255,255,.22); }
  .service-capability nav a { border-color:rgba(255,255,255,.22); }
  .service-button { background:var(--brand); }

  .evidence { background:#e9f1f4; }
  .evidence-head { display:grid; gap:2rem; margin-bottom:3.5rem; }
  .evidence-head .lead { font-size:1.093rem; }
  .evidence-grid { display:grid; grid-template-columns:repeat(12,1fr); grid-auto-rows:clamp(180px,18vw,300px); gap:8px; }
  .evidence-item { overflow:hidden; background:var(--navy); }
  .evidence-item:nth-child(1) { grid-column:span 7; grid-row:span 2; }
  .evidence-item:nth-child(2) { grid-column:span 5; }
  .evidence-item:nth-child(3),.evidence-item:nth-child(4) { grid-column:span 5; }
  .evidence-item:nth-child(4) { grid-column:span 5; }
  .evidence-item :global(img) { width:100%; height:100%; object-fit:cover; }
  .evidence-action { display:flex; justify-content:center; margin-top:2.5rem; }
  .evidence-button { min-height:58px; padding-inline:1.8rem; font-size:1.125rem; }
  .evidence-button span { display:grid; place-items:center; }
  .light { color:var(--navy-deep); }

  @media(min-width:860px) {
    .intake-layout,.evidence-head { grid-template-columns:1fr 1fr; }
    .capability { grid-template-columns:1fr 1fr; }
    .service-capability .capability-image { order:2; }
  }
  @media(max-width:859px) {
    .hero { min-height:780px; }
    .capability { min-height:0; }
    .capability-image { min-height:360px; }
    .service-capability .capability-copy { order:2; }
    .evidence-grid { grid-template-columns:1fr 1fr; grid-auto-rows:210px; }
    .evidence-item:nth-child(n) { grid-column:auto; grid-row:auto; }
    .evidence-item:first-child { grid-column:span 2; grid-row:span 2; }
  }
  @media(max-width:560px) {
    .hero { min-height:720px; }
    .hero-content { padding-top:8rem; padding-bottom:4rem; }
    .hero h1 { font-size:clamp(3rem,15vw,4.35rem); line-height:1.02; }
    .hero p { max-width:31ch; }
    .intake li { grid-template-columns:1fr; gap:.35rem; }
    .capability-image { min-height:300px; }
    .capability-copy { padding:3rem 1rem 4rem; }
    .capability h2 { font-size:clamp(2.4rem,12vw,3.4rem); }
    .evidence-grid { grid-template-columns:1fr; grid-auto-rows:250px; }
    .evidence-item:nth-child(n) { grid-column:auto; grid-row:auto; }
  }
</style>
