---
import BaseLayout from "../layouts/BaseLayout.astro";
import LineAppIcon from "../components/LineAppIcon.astro";
import { products, services } from "../data/catalog";
import { site } from "../config/site";
import legacyPages from "../data/legacy-pages.json";
const facebookPortfolioUrl = "https://www.facebook.com/profile.php?id=100063526152006";
const projectGalleryImages = legacyPages
  .filter((page) => page.type === "project" && page.images.length)
  .slice(0, 5)
  .map((page) => ({
    src: page.images[0].src,
    alt: page.images[0].alt || `ตัวอย่างผลงานวิศวกรรม ${page.heading}`,
  }));
---
<BaseLayout
  title="บริษัท เอสบีซีซี เอ็นจิเนียริ่ง แอนด์ ซัพพลาย จำกัด"
  description="จำหน่ายอุปกรณ์เกี่ยวกับงานวิศวกรรม พุกเคมี, น้ำยาเคมี, Bolt, Nut, เหล็กราง และอุปกรณ์สำหรับงานก่อสร้างทุกชนิด จัดส่งด่วนทั่วไทย พร้อมให้คำปรึกษาฟรี"
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">ENGINEERING SUPPLY & FIELD SERVICE</p>
        <h1 class="display"><span>งานด่วน งานไว<br />คิดถึง เอสบีซีซี</span></h1>
        <p class="lead">SBCC เปิดให้บริการทุกวัน ตั้งแต่เวลา 8:30 – 17:30 น.</p>
        <div class="cluster">
          <a class="button" href={site.lineHref} target="_blank" rel="noopener noreferrer"><LineAppIcon />สอบถามทาง LINE</a>
          <a class="button secondary" href="/quote/">ขอใบเสนอราคา</a>
        </div>
      </div>
      <figure>
        <img src="/images/hero-construction-crane.webp" alt="เครนก่อสร้างในโครงการวิศวกรรม" width="1080" height="675" />
      </figure>
    </div>
  </section>

  <section class="balance">
    <div class="shell balance-head">
      <p class="eyebrow">ONE TEAM, TWO CAPABILITIES</p>
      <h2 class="section-title">จัดหาสินค้าและลงมือทำ<br />ด้วยมาตรฐานเดียวกัน</h2>
      <p class="lead">ทีมเดียวช่วยตรวจสเปก ประเมินหน้างาน และดำเนินงานจนเสร็จสมบูรณ์</p>
    </div>
    <div class="shell split">
      <a href="/products/" class="portal product">
        <span>สินค้า</span>
        <h3>อุปกรณ์สำหรับงานวิศวกรรม</h3>
        <p>พุกเคมี น้ำยาเสียบเหล็ก Bolt Nut Washer และระบบแขวนรองรับ</p>
        <b>ดูสินค้าทั้งหมด →</b>
      </a>
      <a href="/services/" class="portal service">
        <span>บริการ</span>
        <h3>ทีมงานพร้อมเข้าหน้างาน</h3>
        <p>เจาะเสียบเหล็ก เจาะคอริ่ง ซ่อมพื้น และติดตั้งระบบ Hilti</p>
        <b>ดูบริการทั้งหมด →</b>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="shell intro">
      <div>
        <p class="eyebrow">FIELD-PROVEN PRODUCTS</p>
        <h2 class="section-title">เลือกตามประเภทงานและสเปก</h2>
      </div>
    </div>
    <div class="shell grid four">
      {products.map((item) => (
        <a class="card" href={`/products/${item.slug}/`}>
          <img src={item.image} alt={item.title} width="520" height="400" loading="lazy" />
          <div class="card-body"><h3>{item.title}</h3><p>{item.summary}</p></div>
        </a>
      ))}
    </div>
  </section>

  <section class="section dark">
    <div class="shell intro">
      <div>
        <p class="eyebrow orange">SBCC FIELD SERVICES</p>
        <h2 class="section-title">ประเมินหน้างาน วางแผนงาน และส่งมอบอย่างเป็นระบบ</h2>
      </div>
    </div>
    <div class="shell grid two service-grid">
      {services.map((item) => (
        <a class="card service-card" href={`/services/${item.slug}/`}>
          <img src={item.image} alt={item.title} width="720" height="500" loading="lazy" />
          <div class="card-body"><h3>{item.title}</h3><p>{item.summary}</p></div>
        </a>
      ))}
    </div>
  </section>

  <section class="project-evidence section" id="project-evidence">
    <div class="shell evidence-layout">
      <div class="evidence-heading">
        <p class="eyebrow">PROVEN ON-SITE RESULTS</p>
        <h2 class="section-title">ผลงานที่บอกวิธีทำงานได้ชัดกว่าคำโฆษณา</h2>
        <p class="lead">ครอบคลุมงานอาคาร โรงงาน สถาบันการศึกษา หน่วยงานรัฐ และโครงสร้างพื้นฐาน</p>
      </div>
      <div class="project-gallery">
        {projectGalleryImages.map((image) => (
          <a class="gallery-item" href={facebookPortfolioUrl} target="_blank" rel="noopener noreferrer" aria-label="ดูผลงานเพิ่มเติมบน Facebook">
            <img class="gallery-image" src={image.src} alt={image.alt} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section process">
    <div class="shell process-grid">
      <h2 class="section-title">เริ่มต้นง่าย<br />ไม่ต้องศัพท์เทคนิค</h2>
      <ol>
        <li><b>ส่งข้อมูล</b><span>บอกโจทย์ ส่งรูป แบบ หรือรายการสินค้าที่ต้องการ</span></li>
        <li><b>ทีมงานประเมิน</b><span>ตรวจสเปก ปริมาณ เงื่อนไขหน้างาน และระยะเวลา</span></li>
        <li><b>รับข้อเสนอ</b><span>รับคำแนะนำและใบเสนอราคาเพื่อประกอบการตัดสินใจ</span></li>
      </ol>
    </div>
  </section>
</BaseLayout>
<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduceMotion) {
    gsap.utils.toArray<HTMLElement>(".gallery-image").forEach((image) => {
      gsap.fromTo(image, { scale: 0.9, opacity: 0.5 }, {
        scale: 1,
        opacity: 1,
        ease: "none",
        scrollTrigger: { trigger: image, start: "top 95%", end: "bottom 70%", scrub: true },
      });
    });
    if (window.matchMedia("(min-width: 900px)").matches) {
      ScrollTrigger.create({
        trigger: "#project-evidence",
        start: "top 90px",
        end: "bottom bottom",
        pin: ".evidence-heading",
        pinSpacing: false,
      });
    }
  }
</script>
<style>
  .hero { padding: clamp(3rem,7vw,6rem) 0 clamp(5rem,10vw,9rem); }
  .hero-grid { display: grid; align-items: center; gap: clamp(2.5rem,6vw,7rem); }
  .hero-copy { position: relative; z-index: 1; }
  .hero .display { font-size: clamp(2.25rem,4.65vw,3.41rem); }
  .hero .lead { margin: 1.6rem 0 2rem; }
  figure { position: relative; margin: 0; }
  figure::before { position: absolute; z-index: -1; width: 75%; height: 75%; right: -9%; bottom: -12%; background: #d74a2a; content: ""; }
  figure img { width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: center; filter: saturate(.72) contrast(1.05); }
  .balance { padding: clamp(5rem,10vw,9rem) 0 0; border-top: 1px solid #d9d9d0; }
  .balance-head { display: grid; gap: 1.5rem; margin-bottom: 3rem; }
  .split { display: grid; gap: 1px; overflow: hidden; border-radius: 1.25rem; background: #d9d9d0; }
  .portal { min-height: 500px; padding: clamp(2rem,5vw,4.5rem); text-decoration: none; }
  .portal span { font: 700 .9rem "Noto Sans Thai",Arial,sans-serif; }
  .portal h3 { margin: 5rem 0 1rem; font-size: clamp(2rem,3.8vw,3.6rem); }
  .portal p { max-width: 490px; margin-bottom: 2rem; }
  .portal b { font-family: "Noto Sans Thai",Arial,sans-serif; }
  .product { background: #fffdf8; }
  .service { background: #193b31; color: white; }
  .service p { color: #c5d1cc; }
  .intro { display: flex; align-items: flex-end; gap: 2rem; margin-bottom: 3rem; }
  .orange { color: #ff856b; }
  .service-grid { border-color: #39413e; background: #39413e; }
  .service-card { background: #171d1a; color: white; }
  .service-card p { color: #aeb7b2; }
  .service-card img { height: 350px; filter: grayscale(.25) contrast(1.12); }
  .project-evidence { background: #e7e4dc; }
  .evidence-layout { display: grid; gap: 4rem; }
  .evidence-heading { align-self: start; }
  .evidence-heading .lead { margin: 1.5rem 0; }
  .project-gallery { display: grid; grid-template-columns: repeat(6,1fr); grid-auto-rows: clamp(115px,11vw,175px); grid-auto-flow: dense; gap: 6px; overflow: hidden; border-radius: var(--radius); background: #c8cbc5; }
  .gallery-item { position: relative; display: block; overflow: hidden; background: #c8cbc5; }
  .gallery-item:nth-child(1) { grid-column: span 3; grid-row: span 2; }
  .gallery-item:nth-child(2), .gallery-item:nth-child(3) { grid-column: span 3; grid-row: span 1; }
  .gallery-item:nth-child(4) { grid-column: span 2; grid-row: span 2; }
  .gallery-item:nth-child(5) { grid-column: span 4; grid-row: span 2; }
  .gallery-image { width: 100%; height: 100%; object-fit: cover; filter: saturate(.82) contrast(1.06); transition: transform .7s ease, filter .7s ease; }
  .gallery-item:hover .gallery-image { transform: scale(1.05) !important; filter: saturate(1) contrast(1.08); }
  .process-grid { display: grid; gap: 4rem; }
  ol { margin: 0; padding: 0; list-style: none; counter-reset: step; }
  li { display: grid; grid-template-columns: 1fr 1.8fr; gap: 2rem; border-top: 1px solid #c8cbc5; padding: 1.5rem 0; counter-increment: step; }
  li b { font-family: "Noto Sans Thai",Arial,sans-serif; font-size: 1.2rem; }
  li b::before { margin-right: .8rem; color: #9e2f18; content: "0" counter(step); }
  li span { color: #626963; }
  @media (min-width: 860px) {
    .hero-grid { grid-template-columns: minmax(0,1.2fr) minmax(340px,.8fr); }
    .split { grid-template-columns: 1fr 1fr; }
    .process-grid { grid-template-columns: 1fr 1.3fr; }
    .evidence-layout { grid-template-columns: minmax(300px,.8fr) minmax(0,1.2fr); }
  }
  @media (max-width: 700px) {
    .hero .display { font-size: clamp(2.2rem,10.5vw,2.75rem); line-height: 1.08; }
    .intro { display: block; }
    li { grid-template-columns: 1fr; gap: .3rem; }
    .project-gallery { grid-template-columns: repeat(2,1fr); grid-auto-rows: 145px; }
    .gallery-item:nth-child(1) { grid-column: span 2; grid-row: span 2; }
    .gallery-item:nth-child(n+2) { grid-column: span 1; grid-row: span 1; }
  }
</style>
