---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";
import LineAppIcon from "../../components/LineAppIcon.astro";
import SiteImage from "../../components/SiteImage.astro";
---
<BaseLayout
  title="เกี่ยวกับ SBCC Engineering & Supply"
  description="SBCC ช่วยตรวจสเปก จัดหาสินค้าวิศวกรรม ประเมินหน้างาน และให้บริการติดตั้ง"
  breadcrumbs={[{ name: "หน้าแรก", url: "/" }, { name: "เกี่ยวกับเรา", url: "/about/" }]}
>
  <section class="about-hero section">
    <div class="shell hero-layout">
      <h1 class="display">จัดหาสินค้า<br />ด้วยความเข้าใจหน้างาน</h1>
      <div>
        <p class="lead">SBCC ช่วยตรวจสเปก จัดหาสินค้า และประเมินงานติดตั้งจากข้อมูลที่ลูกค้ามี ไม่ว่าจะเป็นรูปหน้างาน แบบ หรือรายการวัสดุ</p>
        <a class="button" href={site.lineHref} target="_blank" rel="noopener noreferrer"><LineAppIcon />ส่งรูปหน้างานทาง LINE</a>
      </div>
    </div>
  </section>

  <section class="about-image"><SiteImage src="/images/project-construction-site.webp" alt="โครงการก่อสร้างที่เกี่ยวข้องกับงานวิศวกรรมของ SBCC" loading="eager" /></section>

  <section class="section approach">
    <div class="shell approach-layout">
      <h2 class="section-title">ส่งข้อมูลที่มี<br />ให้ทีมงานช่วยตรวจ</h2>
      <div class="principles">
        <article><h3>เริ่มจากโจทย์ของลูกค้า</h3><p>รับข้อมูลจากรูปหน้างาน แบบ รายการวัสดุ รุ่นสินค้า หรือคำอธิบายเบื้องต้น</p></article>
        <article><h3>ตรวจทั้งสินค้าและการติดตั้ง</h3><p>ทีมงานพิจารณาสเปก ปริมาณ เงื่อนไขหน้างาน และวิธีดำเนินงานร่วมกัน</p></article>
        <article><h3>ดูผลงานก่อนตัดสินใจ</h3><p>ลูกค้าดูภาพงานอาคาร โรงงาน หน่วยงานรัฐ และงานโครงสร้างพื้นฐานที่ผ่านมาได้จาก Facebook ของ SBCC</p></article>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="shell close-layout"><h2 class="section-title">ตรวจสเปก จัดหาสินค้า<br />และประเมินงานติดตั้ง</h2><div><p class="lead">เลือกดูสินค้าและบริการ หรือส่งรายละเอียดให้ทีมงานช่วยตรวจ</p><div class="cluster"><a class="button" href="/products/">ดูสินค้า</a><a class="button secondary dark-secondary" href="/services/">ดูบริการ</a></div></div></div>
  </section>
</BaseLayout>
<style>
  .hero-layout,.approach-layout,.close-layout{display:grid;gap:3rem;align-items:end}.hero-layout .lead{margin-bottom:2rem}.about-image{height:min(68vw,720px);overflow:hidden}.about-image :global(img){width:100%;height:100%;object-fit:cover;filter:saturate(.82) contrast(1.05)}.principles{border-top:1px solid var(--line)}.principles article{border-bottom:1px solid var(--line);padding:1.4rem 0}.principles h3{font-size:1.35rem}.principles p{max-width:620px;margin-top:.6rem;color:var(--muted)}.close-layout .lead{margin-bottom:2rem}.dark-secondary{border-color:rgba(255,255,255,.42);color:white}.dark-secondary:hover{background:white;color:var(--navy-deep)}
  @media(min-width:850px){.hero-layout,.approach-layout,.close-layout{grid-template-columns:1fr 1fr}}
</style>
