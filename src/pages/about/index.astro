---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";
import LineAppIcon from "../../components/LineAppIcon.astro";
import SiteImage from "../../components/SiteImage.astro";
import ProjectEvidence from "../../components/ProjectEvidence.astro";
import ProjectReels from "../../components/ProjectReels.astro";
---
<BaseLayout
  title="เกี่ยวกับเรา ทีมวิศวกรงานพุกเคมีและงานคอนกรีต | SBCC Engineering"
  description="SBCC Engineering & Supply จำหน่ายอุปกรณ์วิศวกรรมและรับงานเจาะ ตัด สแกนคอนกรีต ทีมวิศวกรตรวจสเปกและประเมินหน้างานก่อนเสนอราคาทุกงาน"
  ogImage="/images/project-construction-site.webp"
  breadcrumbs={[{ name: "หน้าแรก", url: "/" }, { name: "เกี่ยวกับเรา", url: "/about/" }]}
>
  <section class="about-hero section">
    <div class="shell hero-layout">
      <h1 class="display">จัดหาสินค้า<br />ด้วยความเข้าใจ</h1>
      <div>
        <p class="lead">SBCC ช่วยตรวจสเปก จัดหาสินค้า และประเมินงานติดตั้งจากข้อมูลที่ลูกค้ามี ไม่ว่าจะเป็นรูปหน้างาน แบบ หรือรายการวัสดุ</p>
        <a class="button" href={site.lineHref} target="_blank" rel="noopener noreferrer"><LineAppIcon />ส่งรูปหน้างานทาง LINE</a>
      </div>
    </div>
  </section>

  <section class="about-image"><SiteImage src="/images/project-construction-site.webp" alt="โครงการก่อสร้างอาคารที่ SBCC เข้าดำเนินงานเจาะคอริ่งและเจาะเสียบเหล็ก" loading="eager" fetchpriority="high" widths={[760, 1200, 1800]} sizes="100vw" /></section>

  <section class="section facts-section">
    <div class="shell">
      <h2 class="section-title">ข้อมูลบริษัท</h2>
      <dl class="facts">
        <div><dt>ชื่อจดทะเบียน</dt><dd>{site.legalName}</dd></div>
        <div><dt>ขอบเขตงานบริการ</dt><dd>เจาะคอริ่ง · ตัดคอนกรีต · เจาะเสียบเหล็กและติดตั้งพุกเคมี · สแกนหาเหล็กในคอนกรีต · ซ่อมพื้นด้วยโฟมและ Epoxy</dd></div>
        <div><dt>กลุ่มสินค้า</dt><dd>พุกเคมี · น้ำยาเจาะเสียบเหล็ก · พุกฝังคอนกรีตและแองคอร์โบลท์ · ผลิตภัณฑ์ HILTI</dd></div>
        <div><dt>ประเภทงานที่รับ</dt><dd>อาคารสำนักงาน · โรงงานและคลังสินค้า · สถาบันการศึกษา · หน่วยงานรัฐ · งานโครงสร้างพื้นฐาน · งานต่อเติมบ้านพัก</dd></div>
      </dl>
      <p class="facts-note">ที่ตั้งสำนักงาน เวลาทำการ และพื้นที่ให้บริการ ดูได้ที่ <a href="/contact/">หน้าติดต่อเรา</a></p>
    </div>
  </section>

  <ProjectReels
    title="วิดีโอหน้างานจริง"
    titleId="about-reels-title"
    clipLabel="วิดีโอหน้างาน SBCC"
    showMoreLink={false}
  />

  <ProjectEvidence
    title="ผลงานที่ผ่านมา"
    lead="งานเจาะคอริ่ง ตัดคอนกรีต และเจาะเสียบเหล็กในโครงการอาคาร โรงงาน สถาบันการศึกษา หน่วยงานรัฐ และงานโครงสร้างพื้นฐาน ถ่ายจากหน้างานจริงโดยทีมงาน SBCC"
    actionLabel="ดูผลงานทั้งหมดบน Facebook"
  />

</BaseLayout>
<style>
  .facts-section{border-top:1px solid var(--line);background:var(--paper)}
  .facts{display:grid;gap:0;margin:2.5rem 0 0;border-top:1px solid var(--line)}
  .facts > div{display:grid;gap:.35rem 2rem;border-bottom:1px solid var(--line);padding:1.15rem 0}
  .facts dt{color:var(--navy);font-family:"Noto Sans Thai",Arial,sans-serif;font-weight:700}
  .facts dd{margin:0;color:var(--muted);line-height:1.75;overflow-wrap:anywhere}
  .facts dd a{color:var(--navy);text-decoration:underline;text-underline-offset:.2em}
  .facts-note{margin-top:1.5rem;color:var(--muted);font-size:.95rem}
  .facts-note a{color:var(--navy);font-weight:700;text-decoration:underline;text-underline-offset:.2em}
  @media(min-width:760px){.facts > div{grid-template-columns:minmax(180px,.9fr) 2.6fr}}
  .hero-layout{display:grid;gap:3rem;align-items:end}.hero-layout .lead{margin-bottom:2rem}.about-image{height:min(68vw,720px);overflow:hidden}.about-image :global(img){width:100%;height:100%;object-fit:cover;filter:saturate(.82) contrast(1.05)}
  @media(min-width:850px){.hero-layout{grid-template-columns:1fr 1fr}}
</style>
