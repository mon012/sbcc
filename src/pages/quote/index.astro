---
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import { site } from "../../config/site";
---
<BaseLayout title="ขอใบเสนอราคา | SBCC Engineering" description="ส่งรุ่นสินค้า จำนวน รูปหน้างาน หรือแบบให้ทีม SBCC ตรวจข้อมูลและติดต่อกลับเพื่อจัดทำใบเสนอราคา">
  <section class="section">
    <div class="shell quote-grid">
      <div>
        <p class="eyebrow">REQUEST A QUOTE</p>
        <h1 class="display">ขอใบเสนอราคา</h1>
        <p class="lead">ส่งรุ่นสินค้า จำนวน รูปหน้างาน หรือแบบที่มี ทีมงานจะตรวจข้อมูลและติดต่อกลับ</p>
        <div class="direct">
          <a href={site.hotlineHref}><small>Hotline</small>{site.hotlineDisplay}</a>
          <a href={site.hotlineSecondaryHref}><small>Hotline</small>{site.hotlineSecondaryDisplay}</a>
          <a href={site.lineHref} target="_blank" rel="noopener noreferrer"><small>LINE</small>{site.lineDisplay}</a>
          <a href={`mailto:${site.email}`}><small>Email</small>{site.email}</a>
        </div>
      </div>
      <QuoteForm />
    </div>
  </section>
</BaseLayout>
<style>
  .quote-grid{display:grid;gap:4rem;align-items:start}.quote-grid .display{font-size:clamp(3rem,5.263vw,4.46375rem)}.quote-grid .lead{margin:1.5rem 0 2.5rem;font-size:clamp(1rem,1.31vw,1.1125rem)}.direct{display:flex;flex-direction:column;align-items:flex-start;gap:0;border-top:1px solid var(--line)}.direct a{width:100%;border-bottom:1px solid var(--line);padding:1rem 0;text-decoration:none;font-weight:700;transition:color .3s ease}.direct a:hover{color:var(--brand)}.direct small{display:block;color:var(--muted);font-weight:400}
  @media(min-width:900px){.quote-grid{grid-template-columns:.85fr 1.15fr}}
</style>
