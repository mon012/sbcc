---
import SiteImage from "./SiteImage.astro";
import ArrowIcon from "./ArrowIcon.astro";
import { site } from "../config/site";

interface Props {
  title: string;
  lead: string;
  actionLabel?: string;
}

const { title, lead, actionLabel = "ดูผลงานที่ผ่านมา" } = Astro.props;

// One list, rendered on both the homepage and the about page.
const projectEvidence = [
  { src: "/images/0949.webp", alt: "งานเจาะคอริ่งผนังถังคอนกรีตขนาดใหญ่โดยทีมช่าง SBCC" },
  { src: "/images/05342.webp", alt: "ทีมช่าง SBCC ตัดพื้นคอนกรีตกลางแจ้งด้วยเครื่องตัดแนวควบคุม" },
  { src: "/images/09494.webp", alt: "ทีมช่างเจาะคอริ่งพื้นคอนกรีตสำเร็จรูปในโครงการก่อสร้าง" },
  { src: "/images/project-construction-site.webp", alt: "งานเจาะคอริ่งและเจาะเสียบเหล็กในโครงการก่อสร้างอาคาร" },
  { src: "/images/project-coring-precast-slab.jpg", alt: "งานเจาะคอริ่งแผ่นพื้นคอนกรีตสำเร็จรูปหน้างานจริง" },
  { src: "/images/5_0.webp", alt: "ช่างเจาะคอริ่งพื้นคอนกรีตเพื่อเดินท่อในห้องเครื่องปรับอากาศ" },
  { src: "/images/0239.webp", alt: "ช่างผูกเหล็กเสริมโครงสร้างเสาก่อนเทคอนกรีต" },
  { src: "/images/01333.webp", alt: "งานตัดพื้นคอนกรีตในโรงงานจนเห็นแนวเหล็กเสริม" },
  { src: "/images/02233.webp", alt: "งานตัดพื้นคอนกรีตบริเวณลานจอดรถเทรลเลอร์ขนส่ง" },
  { src: "/images/project-residential-site.jpg", alt: "งานเจาะเสียบเหล็กเสริมโครงสร้างในงานต่อเติมบ้านพัก" },
  { src: "/images/project-condominium-site.jpg", alt: "งานเจาะคอริ่งพื้นคอนกรีตในโครงการคอนโดมิเนียม" },
];
---
<section class="evidence section">
  <div class="shell evidence-head">
    <h2 class="section-title" set:html={title} />
    <p class="lead">{lead}</p>
  </div>
  <div class="shell evidence-grid">
    {projectEvidence.map((project) => (
      <div class="evidence-item">
        <SiteImage
          src={project.src}
          alt={project.alt}
          widths={[400, 640, 860]}
          sizes="(min-width: 860px) 400px, (min-width: 561px) 50vw, 100vw"
        />
      </div>
    ))}
  </div>
  <div class="shell evidence-action">
    <a class="button evidence-button" href={site.facebookHref} target="_blank" rel="noopener noreferrer">
      {actionLabel} <span><ArrowIcon direction="up-right" /></span>
    </a>
  </div>
</section>
<style>
  .evidence { background:#e9f1f4; }
  .evidence-head { display:grid; gap:2rem; margin-bottom:3.5rem; }
  .evidence-head .lead { font-size:1.093rem; }
  .evidence-grid { column-count:3; column-gap:8px; }
  .evidence-item { overflow:hidden; background:var(--navy); break-inside:avoid; margin-bottom:8px; }
  .evidence-item :global(img) { display:block; width:100%; height:auto; }
  .evidence-action { display:flex; justify-content:center; margin-top:2.5rem; }
  .evidence-button { min-height:58px; padding-inline:1.8rem; font-size:1.125rem; }
  .evidence-button span { display:grid; place-items:center; }
  @media(min-width:860px) { .evidence-head { grid-template-columns:1fr 1fr; } }
  @media(max-width:859px) { .evidence-grid { column-count:2; } }
  @media(max-width:560px) { .evidence-grid { column-count:1; } }
</style>
