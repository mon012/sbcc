---
import { Image } from "astro:assets";
import lineQrImage from "../assets/images/line-sbcc-qr.png";
import { site } from "../config/site";
import LineAppIcon from "./LineAppIcon.astro";
const currentYear = new Date().getFullYear();
---
<footer class="footer dark">
  <div class="shell footer-grid">
    <div>
      <h2>คุยกับทีม SBCC<br />เพื่อประเมินงานของคุณ</h2>
      <p>ส่งรายละเอียดหรือรูปหน้างาน ทีมงานจะติดต่อกลับเพื่อแนะนำสินค้าและบริการที่เหมาะสม</p>
      <div class="cluster">
        <a class="button" href={site.lineHref} target="_blank" rel="noopener noreferrer"><LineAppIcon />คุยทาง LINE</a>
        <a class="button ghost" href={site.hotlineHref}>โทร {site.hotlineDisplay}</a>
      </div>
    </div>
    <div class="contact">
      <h3>ติดต่อ</h3>
      <a href={site.officeHref}>Office: {site.officeDisplay}</a>
      <a href={site.hotlineHref}>Hotline: {site.hotlineDisplay}</a>
      <a href={site.hotlineSecondaryHref}>Hotline: {site.hotlineSecondaryDisplay}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <div class="line-contact">
        <a href={site.lineHref} target="_blank" rel="noopener noreferrer">LINE: {site.lineDisplay}</a>
        <a class="line-qr" href={site.lineHref} target="_blank" rel="noopener noreferrer" aria-label={`เพิ่มเพื่อน LINE ${site.lineDisplay}`}>
          <Image
            src={lineQrImage}
            alt={`QR Code สำหรับเพิ่มเพื่อน LINE ${site.lineDisplay}`}
            width={118}
            height={118}
            loading="lazy"
            format="webp"
          />
        </a>
      </div>
    </div>
  </div>
  <div class="shell legal">
    <span>© <span data-current-year>{currentYear}</span> {site.legalName}</span>
    <nav class="footer-links" aria-label="ลิงก์เพิ่มเติม">
      <a href="/blog/">บทความ</a>
      <a href="/contact/">ติดต่อเรา</a>
      <a href="/privacy-policy/">นโยบายความเป็นส่วนตัว</a>
    </nav>
  </div>
</footer>
<script is:inline>
  document.querySelectorAll("[data-current-year]").forEach((element) => {
    element.textContent = String(new Date().getFullYear());
  });
</script>
<style>
  .footer { padding: clamp(5rem,10vw,8rem) 0 2rem; }
  .footer-grid { display: grid; gap: 4rem; }
  h2 { max-width: 780px; font-size: clamp(2.4rem,5vw,4.8rem); }
  p { max-width: 650px; margin: 1.5rem 0 2rem; color: #bdc4bf; font-size: 1.1rem; }
  .ghost { border-color: #758079; background: transparent; }
  .contact { display: flex; flex-direction: column; align-items: flex-start; gap: .8rem; }
  .contact a, .legal a { color: #dce1dd; text-decoration: none; }
  .line-contact { display: grid; gap: .8rem; margin-top: .2rem; }
  .line-qr { display: block; overflow: hidden; width: 118px; border-radius: .75rem; background: white; }
  .line-qr img { display: block; width: 100%; height: auto; }
  .footer-links { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: .4rem; }
  .footer-links a + a::before { margin-right: .4rem; color: #89918c; content: "/"; }
  .legal { display: flex; justify-content: space-between; gap: 1rem; margin-top: 5rem; border-top: 1px solid #36413d; padding-top: 1.5rem; color: #89918c; font-size: .85rem; }
  @media (min-width: 860px) { .footer-grid { grid-template-columns: 2.5fr 1fr; } }
  @media (max-width: 600px) {
    .legal { flex-direction: column; }
    .footer-links { justify-content: flex-start; }
  }
</style>
