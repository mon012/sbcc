---
import { site } from "../config/site";
---
<nav class="mobile-actions" aria-label="ช่องทางติดต่อด่วน">
  <a href={site.hotlineHref} aria-label="โทรหา SBCC">
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6.6 10.8a15.7 15.7 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.28.56 3.48.56a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.56 21 3 13.44 3 4.12a1 1 0 0 1 1-1H7.5a1 1 0 0 1 1 1c0 1.2.19 2.38.56 3.48a1 1 0 0 1-.25 1.02L6.6 10.8Z" />
    </svg>
    <span>โทร</span>
  </a>
  <a class="line" href={site.lineHref} target="_blank" rel="noopener noreferrer" aria-label="ติดต่อ SBCC ทาง LINE">
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.8 10.4c0-4-4-7.2-8.8-7.2s-8.8 3.2-8.8 7.2c0 3.58 3.12 6.58 7.34 7.14.28.06.67.2.77.46.09.23.06.58.03.81l-.12.77c-.04.23-.18.9.78.49.97-.41 5.2-3.06 7.1-5.25 1.17-1.28 1.7-2.58 1.7-4.42Z" />
    </svg>
    <span>LINE</span>
  </a>
</nav>
<style>
  .mobile-actions { display:none; }
  @media(max-width:759px) {
    .mobile-actions { position:fixed; z-index:60; right:0; bottom:0; left:0; display:grid; height:64px; grid-template-columns:1fr 1fr; overflow:hidden; border-top:1px solid rgba(255,255,255,.18); background:var(--navy-deep); color:white; }
    .mobile-actions a { display:flex; min-width:0; height:64px; align-items:center; justify-content:center; gap:.55rem; overflow:hidden; border-right:1px solid rgba(255,255,255,.16); padding:.5rem 1rem; color:inherit; text-align:center; text-decoration:none; }
    .mobile-actions a:last-child { border-right:0; }
    .mobile-actions .line { background:var(--brand); }
    .mobile-actions svg { display:block; width:22px !important; height:22px !important; max-width:22px; max-height:22px; flex:0 0 22px; fill:currentColor; }
    .mobile-actions span { font-family:"Noto Sans Thai",Arial,sans-serif; font-size:.9rem; font-weight:700; line-height:1.2; }
  }
</style>
