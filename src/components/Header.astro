---
import { site } from "../config/site";
import LineAppIcon from "./LineAppIcon.astro";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
---
<header class:list={["site-header", { overlay }]}>
  <div class="shell nav">
    <a class="wordmark" href="/" aria-label="SBCC Engineering หน้าแรก">
      <strong>SBCC</strong>
      <span>Engineering &amp; Supply</span>
    </a>

    <nav class="desktop-nav" aria-label="เมนูหลัก">
      <a href="/products/">สินค้า</a>
      <a href="/services/">บริการ</a>
    </nav>

    <a class="line-action" href={site.lineHref} target="_blank" rel="noopener noreferrer">
      <LineAppIcon />
      <span>คุยทาง LINE</span>
    </a>

    <details class="mobile-menu">
      <summary aria-label="เปิดเมนูหลัก"><span>เมนู</span><i></i></summary>
      <div class="mobile-panel">
        <a href="/products/">สินค้า</a>
        <a href="/services/">บริการ</a>
        <a class="mobile-line" href={site.lineHref} target="_blank" rel="noopener noreferrer">ส่งรูปหน้างานทาง LINE</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgba(255,255,255,.97);
    color: var(--navy-deep);
  }
  .site-header.overlay {
    position: absolute;
    right: 0;
    left: 0;
    border-color: rgba(255,255,255,.25);
    background: transparent;
    color: white;
  }
  .nav { display: flex; min-height: 82px; align-items: center; gap: clamp(1rem,2.3vw,2.25rem); }
  .wordmark { display: flex; align-items: baseline; gap: .55rem; margin-right: auto; color: inherit; text-decoration: none; white-space: nowrap; }
  .wordmark strong { font: 900 1.35rem/1 "Noto Sans Thai",Arial,sans-serif; letter-spacing: -.035em; }
  .wordmark span { font-size: .74rem; letter-spacing: .035em; text-transform: uppercase; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(1rem,1.8vw,1.8rem); }
  .desktop-nav a { position: relative; color: inherit; font-family: "Noto Sans Thai",Arial,sans-serif; font-size:1.0075rem; font-weight:600; text-decoration:none; }
  .desktop-nav a::after { position: absolute; right: 0; bottom: -.45rem; left: 0; height: 1px; background: currentColor; content: ""; transform: scaleX(0); transform-origin: right; transition: transform .3s var(--ease-out); }
  .desktop-nav a:hover::after { transform: scaleX(1); transform-origin: left; }
  .line-action { display: inline-flex; min-height: 44px; align-items: center; gap: .45rem; border-radius: 999px; padding: .65rem 1rem .65rem 1.15rem; background: var(--brand); color: white; font-family: "Noto Sans Thai",Arial,sans-serif; font-size: .78rem; font-weight: 800; text-decoration: none; transition: transform .3s var(--ease-out), background .3s ease; }
  .line-action:hover { transform: translateY(-2px); background: var(--brand-dark); }
  .line-action svg { width: 18px; height: 18px; }
  .mobile-menu { display: none; }
  @media (max-width: 980px) {
    .desktop-nav, .line-action { display: none; }
    .mobile-menu { display: block; }
    summary { display: flex; min-width: 72px; min-height: 44px; align-items: center; justify-content: center; gap: .55rem; border: 1px solid currentColor; border-radius: 999px; cursor: pointer; font-family: "Noto Sans Thai",Arial,sans-serif; font-size: .82rem; font-weight: 700; list-style: none; }
    summary::-webkit-details-marker { display: none; }
    summary i, summary i::before { display: block; width: 14px; height: 1px; background: currentColor; content: ""; transition: transform .25s ease; }
    summary i::before { transform: translateY(5px); }
    details[open] summary i { transform: rotate(45deg); }
    details[open] summary i::before { transform: rotate(90deg); }
    .mobile-panel { position: fixed; top: 82px; right: 0; left: 0; display: grid; border-top: 1px solid var(--line); background: white; color: var(--navy-deep); box-shadow: var(--shadow); }
    .mobile-panel a { border-bottom: 1px solid var(--line); padding: 1rem 20px; font-family: "Noto Sans Thai",Arial,sans-serif; font-size: 1.05rem; font-weight: 700; text-decoration: none; }
    .mobile-panel .mobile-line { background: var(--brand); color: white; }
  }
  @media (max-width: 520px) {
    .nav { min-height: 72px; }
    .wordmark span { display: none; }
    .mobile-panel { top: 72px; }
  }
</style>
